# ResearchScope Environment Configuration Template

# Server Configuration
PORT=8081

# MySQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/researchscope_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=

# Academic Data Providers (Optional / Recommended for Higher Rate Limits)
