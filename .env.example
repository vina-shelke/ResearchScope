# ==============================================================================
# ResearchScope - Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. DO NOT commit actual secrets or production passwords to version control.
# 2. Copy this file to '.env' for local development:
#      cp .env.example .env
# 3. For CI/CD, GitHub, and production deployments, configure these as encrypted
#    environment variables / GitHub Repository Secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
PORT=8081

# ------------------------------------------------------------------------------
# 2. Database Configuration (MySQL 8.x / 9.x)
# ------------------------------------------------------------------------------
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/researchscope_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=
SPRING_JPA_HIBERNATE_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=false

# ------------------------------------------------------------------------------
# 3. Artificial Intelligence Assistants (Optional)
#    Provide at least one API key to enable grounded synthesis via cloud models.
#    If omitted, ResearchScope seamlessly uses the built-in local heuristic engine.
# ------------------------------------------------------------------------------
# Google Gemini API Key (e.g. from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=

# OpenAI API Key (e.g. https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 4. Scholarly API Data Providers (Optional / Recommended for Higher Rate Limits)
# ------------------------------------------------------------------------------
# OpenAlex polite pool email (guarantees fast response times):
OPENALEX_MAILTO=researcher@example.com
OPENALEX_BASE_URL=https://api.openalex.org

# Crossref Base URL:
CROSSREF_BASE_URL=https://api.crossref.org

# Semantic Scholar API Key (optional partner key for elevated rate limits):
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_BASE_URL=https://api.semanticscholar.org/graph/v1

# ------------------------------------------------------------------------------
# 5. Frontend Client Configuration (Vite)
# ------------------------------------------------------------------------------
# Base API URL used by the React client.
# In local development or unified Spring Boot deployments, defaults to /api or http://localhost:8081/api
VITE_API_BASE_URL=http://localhost:8081/api
